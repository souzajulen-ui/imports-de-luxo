# ============================================================================
# Imports de Luxo — variáveis do Supabase
#
# ATENÇÃO: este site é HTML estático (sem build), então ele NÃO lê arquivos .env.
# Os valores abaixo devem ser copiados para dentro de assets/cms-config.js.
# Este arquivo existe só como referência do que você precisa ter em mãos.
#
# Onde achar: painel do Supabase -> Project Settings -> API
# ============================================================================

# Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# anon public key (pode ficar no navegador — é protegida pelo RLS)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# NUNCA coloque a service_role key no site nem neste repositório.
# SUPABASE_SERVICE_ROLE_KEY=nao-use-aqui
